NODE_ENV=development
PROJECT_NAME=<%= projectName %>
PORT=3000

# MongoDB
# Optional — when set, overrides the individual DB_* variables below
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_USER=root
DB_PASSWORD=password
HOST=localhost
DB_PORT=27017
DB_NAME=<%= projectNameLowerCase %>

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# Encryption
CRYPTO_SECURE_ENCRYPTION=false    # Set true to use RSA+AES-GCM (crypto-secure), false for legacy AES-CBC

# RSA keypair (required when CRYPTO_SECURE_ENCRYPTION=true — generate once, then paste here)
# Run the server once with CRYPTO_SECURE_ENCRYPTION=true to generate keys and copy them below
# CRYPTO_SECURE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpA..."
# CRYPTO_SECURE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj..."

# Legacy AES-CBC (used when CRYPTO_SECURE_ENCRYPTION=false)
SECRET_KEY=your-32-byte-secret-key-here
ENCRYPTION_IV=your-16-byte-iv-here

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@<%= projectNameLowerCase %>.com
ADMINEMAIL=admin@<%= projectNameLowerCase %>.com

# Frontend / Backend URLs
FRONT_WEB_URL=http://localhost:5173     # Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173      # Alias for frontend URL
BACK_WEB_URL=http://localhost:4000      # Backend URL (used in email links)

# Seed
RUN_SEED=true                              # Seed default roles and admin user on startup
SEED_ADMIN_EMAIL=admin@test.com            # Admin email (used when RUN_SEED=true)
SEED_ADMIN_PASSWORD=Admin@123              # Admin password (used when RUN_SEED=true)

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx        # Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx      # Stripe webhook signing secret

# CORS
CORS_ORIGIN=*    # Set to your frontend URL in production (e.g., https://example.com)